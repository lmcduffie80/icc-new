## 🎯 Common Patterns

### Admin Routes

```typescript
import { verifyAdminAuth } from '@/lib/admin-middleware';

export async function POST(request: NextRequest) {
  const authResult = await verifyAdminAuth(request);
  if (!authResult.authorized) {
    return authResult.response!;
  }
  // Admin is authenticated and authorized
}
```

### Public API Routes

```typescript
import { rateLimiters, checkRateLimit, createRateLimitResponse } from '@/lib/rate-limit';
import { contactFormSchema } from '@/lib/validation';

export async function POST(request: NextRequest) {
  // Validate
  const body = await request.json();
  const result = contactFormSchema.safeParse(body);
  if (!result.success) {
    return NextResponse.json({ error: 'Validation failed' }, { status: 400 });
  }

  // Rate limit
  const rateLimitResult = await checkRateLimit(request, rateLimiters.moderate);
  if (!rateLimitResult.success) {
    return createRateLimitResponse(rateLimitResult.reset);
  }

  // Process
  // ...
}
```

### Form Validation

```typescript
// 1. Create schema in lib/validation.ts
export const myFormSchema = z.object({
  field: z.string().min(1).max(100),
  email: z.string().email(),
});

// 2. Use in API route
const result = myFormSchema.safeParse(body);
```

### New Components with Tests

```typescript
// components/my-component.tsx
export function MyComponent({ prop }: MyComponentProps) {
  // Implementation
}

// __tests__/components/my-component.test.tsx
import { render, screen } from '@testing-library/react';
import { MyComponent } from '@/components/my-component';

describe('MyComponent', () => {
  it('should render correctly', () => {
    render(<MyComponent prop="value" />);
    expect(screen.getByText('value')).toBeInTheDocument();
  });
});
```

---

## ❌ Anti-Patterns to Avoid

**Never do these:**

- ❌ Skip validation on API routes
- ❌ Trust client-provided prices, totals, or sensitive data
- ❌ Expose sensitive data in API responses (passwords, tokens, internal IDs)
- ❌ Create admin routes without `verifyAdminAuth()`
- ❌ Commit code without running tests and build
- ❌ Use `any` type without strong justification
- ❌ Concatenate user input into SQL queries
- ❌ Skip rate limiting on public endpoints
- ❌ Log sensitive data (passwords, tokens, credit cards)
- ❌ Return detailed error messages to clients (expose internal details)
- ❌ Commit `.env.local` or secrets
- ❌ Use npm or yarn instead of pnpm
- ❌ Mix package managers or have multiple lock files
- ❌ Commit `package-lock.json` or `yarn.lock` files

