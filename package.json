{
  "name": "ecommerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "prepare": "bash scripts/install-hooks.sh",
    "dev": "next dev --port 3000 --hostname localhost",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint app components lib -D nextjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "db:migrate": "dotenv -e .env.local -- pnpm exec better-auth migrate",
    "db:generate": "dotenv -e .env.local -- pnpm exec better-auth generate",
    "db:migrate:orders": "dotenv -e .env.local -- pnpm exec tsx scripts/migrate.ts",
    "db:migrate:test": "dotenv -e .env.test -- pnpm exec better-auth migrate",
    "db:migrate:test:orders": "dotenv -e .env.test -- pnpm exec tsx scripts/migrate.ts",
    "db:seed:test": "dotenv -e .env.test -- pnpm exec tsx scripts/seed-test-db.ts",
    "test:pdfshift": "dotenv -e .env.local -- pnpm exec tsx scripts/test-pdfshift.ts",
    "diagnose:images": "dotenv -e .env.local -- pnpm exec tsx scripts/diagnose-images.ts",
    "git:clean-icons": "bash scripts/clean-git-icons.sh",
    "fix-limits": "bash scripts/fix-file-limits.sh",
    "dev:safe": "bash scripts/fix-file-limits.sh && next dev --port 3000 --hostname localhost"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
    "@anthropic-ai/sdk": "^0.95.2",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@better-auth/passkey": "^1.6.10",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@svg-maps/usa": "^2.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^6.0.177",
    "better-auth": "^1.6.10",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.555.0",
    "next": "^16.2.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "playwright": "1.60.0",
    "postcss": "^8.5.14",
    "prop-types": "^15.8.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-qr-code": "^2.0.21",
    "react-transition-group": "^4.4.5",
    "recharts": "^2.15.4",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "stripe": "^20.4.0",
    "tailwind-merge": "^3.6.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@noble/hashes": "^2.2.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.2.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.6",
    "bcryptjs": "^3.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.9.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "node-mocks-http": "^1.17.2",
    "oxlint": "^1.64.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.0",
      "fast-xml-parser": ">=5.5.7",
      "minimatch": ">=10.2.3",
      "rollup": ">=4.59.0",
      "ajv": ">=8.18.0",
      "flatted": ">=3.4.0",
      "happy-dom": ">=20.8.8",
      "kysely": ">=0.28.14",
      "vite": ">=7.3.2",
      "defu": ">=6.1.5",
      "picomatch": ">=4.0.4",
      "nodemailer": ">=8.0.5",
      "mailparser": ">=3.9.3",
      "drizzle-orm": ">=0.45.2",
      "brace-expansion": ">=5.0.5"
    }
  }
}
